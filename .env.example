# OWA — образец файла конфигурации.
# Скопируйте в .env (start.bat сделает это сам при первом запуске) и заполните.
# Файл .env не попадает в git.

# --- Сервер -----------------------------------------------------------
# Порт веб-интерфейса и API.
PORT=3210
# Интерфейс для прослушивания.
# 127.0.0.1 — только локально. 0.0.0.0 — доступно из сети, НО включайте его
# только вместе с включённой авторизацией (AUTH_PASSWORD_HASH), иначе анализ
# и токены GLM будут доступны всем в сети (ТЗ 4.1).
HOST=127.0.0.1

# --- Браузер -----------------------------------------------------------
# Какой Chromium запускать. Пусто (по умолчанию) — сначала Chromium из кэша
# Playwright (npx playwright install chromium), а если его нет — системный
# Chrome, затем Edge. Задайте канал явно, если нужен конкретный браузер:
# OWA_BROWSER_CHANNEL=chrome или OWA_BROWSER_CHANNEL=msedge
OWA_BROWSER_CHANNEL=

# --- Авторизация ------------------------------------------------------
# Ничего не настроено: сервер по умолчанию приватный — слушает только 127.0.0.1,
# при попытке HOST=0.0.0.0 откажется запускаться.
# Доступ извне возможен ТОЛЬКО тут:
#
#   Basic Auth — AUTH_LOGIN + AUTH_PASSWORD_HASH (bcrypt-хэш пароля).
#     Сгенерировать: node -e "require('bcrypt').hash('ВАШ_ПАРОЛЬ',10,(e,h)=>console.log(h))"
#   Bearer-токен — API_BEARER_TOKEN (для скриптов и ИИ-агентов, заголовок
#     Authorization: Bearer <token>). Работает вместе с Basic: Bearer бьёт
#     приоритетом на /api/*, остальное (UI) уходит на Basic.
#
# /health и /api/health остаются открытыми всегда — для проверок живости.
AUTH_LOGIN=admin
AUTH_PASSWORD_HASH=

# Bearer-токен для API (для скриптов и ИИ-агентов).
# Authorization: Bearer <API_BEARER_TOKEN>
API_BEARER_TOKEN=

# --- Безопасность и лимиты -------------------------------------------
# Запретить приватные адреса как цели анализа (public-деплой, защита от SSRF):
# тогда http://127.0.0.1/ и локальные IP отклоняются с 400. Локально — не надо.
OWA_DENY_PRIVATE_TARGETS=0
# Сколько запусков Chromium держим одновременно (каждый — сотни МБ RAM).
OWA_MAX_CONCURRENT=2
# Разрешить видимый браузер через API (OWA_ALLOW_HEADED=1). По умолчанию нет:
# иначе запрос из сети открывает окно браузера на машине сервера.
OWA_ALLOW_HEADED=0
# Сколько дней хранить анализы, кэш AI и мёртвые сессии (0 — без ограничений).
OWA_RETENTION_DAYS=30
# Как часто обслуживать БД (чистка просроченного + чекпоинт WAL), мс.
OWA_MAINTENANCE_EVERY_MS=21600000
# Таймаут одного вызова MCP-инструмента analyze_url, мс.
OWA_MCP_TOOL_TIMEOUT_MS=300000

# --- AI: GLM (OpenAI-совместимый endpoint) ----------------------------
# Ключ хранится только здесь: не в git, не в логах, не в SQLite.
GLM_API_KEY=
GLM_BASE_URL=https://api.z.ai/api/paas/v4
GLM_MODEL=glm-4.5
GLM_TIMEOUT_MS=30000
GLM_MAX_TOKENS=2000
GLM_TEMPERATURE=0.3
